# Development fixture only. This is not an official Termux package recipe.

TERMUX_PKG_HOMEPAGE=https://github.com/frenchfaso/termux-stacks
TERMUX_PKG_DESCRIPTION="Declarative service stacks for Termux using PRoot"
TERMUX_PKG_LICENSE="Apache-2.0"
TERMUX_PKG_MAINTAINER="@frenchfaso"
TERMUX_PKG_VERSION=0.1.0-rc.1
TERMUX_PKG_SRCURL="https://github.com/frenchfaso/termux-stacks/archive/refs/tags/v${TERMUX_PKG_VERSION//\~/-}.tar.gz"
TERMUX_PKG_SHA256="<sha256>"
TERMUX_PKG_DEPENDS="libsqlite, proot-distro (= 5.6.0), termux-services"
TERMUX_PKG_BUILD_IN_SRC=true
TERMUX_PKG_EXTRA_CONFIGURE_ARGS="--bin termux-stacks"
TERMUX_PKG_SERVICE_SCRIPT=(
	"termux-stacksd" 'exec "$PREFIX/bin/termux-stacks" daemon 2>&1'
)

termux_step_pre_configure() {
	termux_setup_rust
}

termux_step_create_debscripts() {
	local removal_guard='[ "${1:-}" = remove ]'
	local purge_guard='[ "${1:-}" = purge ]'
	if [ "${TERMUX_PACKAGE_FORMAT:-debian}" = pacman ]; then
		removal_guard=true
		purge_guard=false
	fi

	cat <<- EOF > ./prerm
		#!${TERMUX_PREFIX}/bin/sh
		if ${removal_guard}; then
			service_dir="${TERMUX_PREFIX}/var/service/termux-stacksd"
			if [ -e "\${service_dir}" ] || [ -L "\${service_dir}" ]; then
				[ -d "\${service_dir}" ] && [ ! -L "\${service_dir}" ] || exit 1
				cd "\${service_dir}" || exit 1
				down_file="\${service_dir}/down"
				if [ -e "\${down_file}" ] || [ -L "\${down_file}" ]; then
					[ -f "\${down_file}" ] && [ ! -L "\${down_file}" ] || exit 1
				fi
				[ -x "${TERMUX_PREFIX}/bin/touch" ] || exit 1
				umask 077
				"${TERMUX_PREFIX}/bin/touch" "\${down_file}" || exit 1
				[ -x "${TERMUX_PREFIX}/bin/sv" ] || exit 1
				[ -x "${TERMUX_PREFIX}/bin/sleep" ] || exit 1
				pid_file="\${service_dir}/supervise/pid"
				read_service_pid() {
					service_pid=
					if [ -e "\${pid_file}" ] || [ -L "\${pid_file}" ]; then
						[ -f "\${pid_file}" ] && [ ! -L "\${pid_file}" ] || exit 1
						if [ -s "\${pid_file}" ]; then
							IFS= read -r service_pid < "\${pid_file}" || exit 1
						fi
						case "\${service_pid}" in
							'') ;;
							*[!0-9]* | 0*) exit 1 ;;
						esac
					fi
				}
				read_service_pid
				previous_service_pid=\${service_pid}

				stop_rc=0
				stop_output=\$(SVDIR="${TERMUX_PREFIX}/var/service" \
					"${TERMUX_PREFIX}/bin/sv" -w 20 down termux-stacksd \
					2>&1) || stop_rc=\$?
				printf 'termux-stacks: sv down rc=%s: %s\n' \
					"\${stop_rc}" "\${stop_output:-<empty>}" >&2

				status_attempt=0
				status_attempt_limit=5
				stop_proven=0
				service_status=
				status_rc=0
				while [ "\${status_attempt}" -lt "\${status_attempt_limit}" ]; do
					status_attempt=\$((status_attempt + 1))
					read_service_pid
					observed_before_status=\${service_pid}
					if [ -n "\${observed_before_status}" ] && \
						[ "\${observed_before_status}" != "\${previous_service_pid}" ]; then
						printf '%s\n' \
							'termux-stacks: supervised daemon PID changed after stop request; removal aborted' >&2
						exit 1
					fi

					status_rc=0
					service_status=\$(SVDIR="${TERMUX_PREFIX}/var/service" \
						"${TERMUX_PREFIX}/bin/sv" status termux-stacksd 2>&1) || \
						status_rc=\$?
					printf 'termux-stacks: sv status attempt %s/%s rc=%s: %s\n' \
						"\${status_attempt}" "\${status_attempt_limit}" "\${status_rc}" \
						"\${service_status:-<empty>}" >&2

					read_service_pid
					observed_after_status=\${service_pid}
					if [ -n "\${observed_after_status}" ] && \
						[ "\${observed_after_status}" != "\${previous_service_pid}" ]; then
						printf '%s\n' \
							'termux-stacks: supervised daemon PID changed during stop proof; removal aborted' >&2
						exit 1
					fi

					pid_alive=0
					for observed_pid in "\${previous_service_pid}" \
						"\${observed_before_status}" "\${observed_after_status}"; do
						if [ -n "\${observed_pid}" ] && \
							kill -0 "\${observed_pid}" 2>/dev/null; then
							pid_alive=1
						fi
					done

					terminal_status=0
					if [ "\${service_status}" = \
						'fail: termux-stacksd: runsv not running' ]; then
						terminal_status=1
					else
						main_status=\${service_status%%; *}
						case "\${main_status}" in
							'down: termux-stacksd: '*'s')
								elapsed=\${main_status#down: termux-stacksd: }
								elapsed=\${elapsed%s}
								case "\${elapsed}" in
									'' | *[!0-9]*) ;;
									*) terminal_status=1 ;;
								esac
								;;
						esac
					fi

					if [ "\${terminal_status}" -eq 1 ] && [ "\${pid_alive}" -eq 0 ]; then
						read_service_pid
						observed_final_pid=\${service_pid}
						if [ -n "\${observed_final_pid}" ] && \
							[ "\${observed_final_pid}" != "\${previous_service_pid}" ]; then
							printf '%s\n' \
								'termux-stacks: supervised daemon PID changed after terminal status; removal aborted' >&2
							exit 1
						fi
						pid_alive=0
						for observed_pid in "\${previous_service_pid}" \
							"\${observed_before_status}" "\${observed_after_status}" \
							"\${observed_final_pid}"; do
							if [ -n "\${observed_pid}" ] && \
								kill -0 "\${observed_pid}" 2>/dev/null; then
								pid_alive=1
							fi
						done
						if [ "\${pid_alive}" -eq 0 ]; then
							stop_proven=1
							break
						fi
					fi

					if [ "\${status_attempt}" -lt "\${status_attempt_limit}" ]; then
						"${TERMUX_PREFIX}/bin/sleep" 1 || exit 1
					fi
				done

				if [ "\${stop_proven}" -ne 1 ]; then
					printf 'termux-stacks: service stop could not be proven after %s status attempts; removal aborted\n' \
						"\${status_attempt_limit}" >&2
					exit 1
				fi
			fi
		fi
	EOF

	cat <<- EOF > ./postrm
		#!${TERMUX_PREFIX}/bin/sh
		if ${purge_guard}; then
			rm -rf -- "${TERMUX_PREFIX}/var/service/termux-stacksd"
		fi
	EOF
	chmod 0700 ./prerm ./postrm
}
