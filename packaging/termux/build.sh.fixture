# Development fixture only. This is not an official Termux package recipe.

TERMUX_PKG_HOMEPAGE=https://github.com/frenchfaso/termux-stacks
TERMUX_PKG_DESCRIPTION="Declarative service stacks for Termux using PRoot"
TERMUX_PKG_LICENSE="Apache-2.0"
TERMUX_PKG_MAINTAINER="@frenchfaso"
TERMUX_PKG_VERSION=0.1.0-rc.1
TERMUX_PKG_SRCURL="https://github.com/frenchfaso/termux-stacks/archive/refs/tags/v${TERMUX_PKG_VERSION//\~/-}.tar.gz"
TERMUX_PKG_SHA256="<sha256>"
TERMUX_PKG_DEPENDS="libsqlite, proot-distro (= 5.6.0), termux-services"
TERMUX_PKG_BUILD_IN_SRC=true
TERMUX_PKG_EXTRA_CONFIGURE_ARGS="--bin termux-stacks"
TERMUX_PKG_SERVICE_SCRIPT=(
	"termux-stacksd" 'exec "$PREFIX/bin/termux-stacks" daemon 2>&1'
)

termux_step_pre_configure() {
	termux_setup_rust
}

termux_step_create_debscripts() {
	local removal_guard='[ "${1:-}" = remove ]'
	local purge_guard='[ "${1:-}" = purge ]'
	if [ "${TERMUX_PACKAGE_FORMAT:-debian}" = pacman ]; then
		removal_guard=true
		purge_guard=false
	fi

	cat <<- EOF > ./prerm
		#!${TERMUX_PREFIX}/bin/sh
		if ${removal_guard}; then
			service_dir="${TERMUX_PREFIX}/var/service/termux-stacksd"
			if [ -e "\${service_dir}" ] || [ -L "\${service_dir}" ]; then
				[ -d "\${service_dir}" ] && [ ! -L "\${service_dir}" ] || exit 1
				down_file="\${service_dir}/down"
				if [ -e "\${down_file}" ] || [ -L "\${down_file}" ]; then
					[ -f "\${down_file}" ] && [ ! -L "\${down_file}" ] || exit 1
				fi
				[ -x "${TERMUX_PREFIX}/bin/touch" ] || exit 1
				umask 077
				"${TERMUX_PREFIX}/bin/touch" "\${down_file}" || exit 1
				[ -x "${TERMUX_PREFIX}/bin/sv" ] || exit 1
				pid_file="\${service_dir}/supervise/pid"
				read_service_pid() {
					service_pid=
					if [ -e "\${pid_file}" ] || [ -L "\${pid_file}" ]; then
						[ -f "\${pid_file}" ] && [ ! -L "\${pid_file}" ] || exit 1
						if [ -s "\${pid_file}" ]; then
							IFS= read -r service_pid < "\${pid_file}" || exit 1
						fi
						case "\${service_pid}" in
							'') ;;
							*[!0-9]* | 0*) exit 1 ;;
						esac
					fi
				}
				read_service_pid
				previous_service_pid=\${service_pid}

				stop_rc=0
				SVDIR="${TERMUX_PREFIX}/var/service" \
					"${TERMUX_PREFIX}/bin/sv" -w 20 down termux-stacksd \
					>/dev/null 2>&1 || stop_rc=\$?

				read_service_pid
				for observed_pid in "\${previous_service_pid}" "\${service_pid}"; do
					if [ -n "\${observed_pid}" ] && kill -0 "\${observed_pid}" 2>/dev/null; then
						printf '%s\n' \
							'termux-stacks: supervised daemon did not stop; removal aborted' >&2
						exit 1
					fi
				done
				if [ "\${stop_rc}" -ne 0 ]; then
					service_status=\$(SVDIR="${TERMUX_PREFIX}/var/service" \
						"${TERMUX_PREFIX}/bin/sv" status termux-stacksd 2>&1 || :)
					stop_proven=0
					if [ "\${service_status}" = \
						'fail: termux-stacksd: runsv not running' ]; then
						stop_proven=1
					else
						main_status=\${service_status%%; *}
						case "\${main_status}" in
							'down: termux-stacksd: '*'s')
								elapsed=\${main_status#down: termux-stacksd: }
								elapsed=\${elapsed%s}
								case "\${elapsed}" in
									'' | *[!0-9]*) ;;
									*) stop_proven=1 ;;
								esac
								;;
						esac
					fi
					if [ "\${stop_proven}" -ne 1 ]; then
						printf '%s\n' \
							'termux-stacks: service stop could not be proven; removal aborted' >&2
						exit 1
					fi
					read_service_pid
					if [ -n "\${service_pid}" ] && kill -0 "\${service_pid}" 2>/dev/null; then
						printf '%s\n' \
							'termux-stacks: supervised daemon restarted; removal aborted' >&2
						exit 1
					fi
				fi
			fi
		fi
	EOF

	cat <<- EOF > ./postrm
		#!${TERMUX_PREFIX}/bin/sh
		if ${purge_guard}; then
			rm -rf -- "${TERMUX_PREFIX}/var/service/termux-stacksd"
		fi
	EOF
	chmod 0700 ./prerm ./postrm
}
